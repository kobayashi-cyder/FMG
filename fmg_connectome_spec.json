{
  "schema": "fmg.fly-connectome-spec.v2.2",
  "name": "FMG Fly Connectome Image Controller 1024",
  "biological_fidelity": "connectome-inspired engineering abstraction",
  "flow": [
    "sensory_prompt_and_effort",
    "PN_like_channels",
    "KC_like_sparse_expansion",
    "MBON_competition",
    "lazy_image_organ_1024",
    "artifact_verifier",
    "DAN_like_reward",
    "KC_to_MBON_plasticity"
  ],
  "topology": {
    "pn_count": 64,
    "kc_count": 1024,
    "kc_fan_in": 6,
    "kc_target_sparsity": 0.05,
    "mbon_outputs": [
      "a1111",
      "diffusers"
    ]
  },
  "constraints": {
    "qwen": false,
    "cloud_api_required": false,
    "offline_after_model_prepare": true,
    "large_central_planner": false
  },
  "image_profile": {
    "width": 1024,
    "height": 1024,
    "fixed": true,
    "default_steps": 50,
    "default_guidance": 9
  },
  "quality_reflex": {
    "evaluator": "lightweight technical metrics",
    "threshold": 0.52,
    "motor_outputs": [
      "evaluate",
      "repair",
      "accept"
    ],
    "repair": {
      "backend": "A1111/Forge img2img mask",
      "denoising_strength": 0.28,
      "max_regions": 3,
      "accept_only_if_improved": true
    },
    "semantic_vision_model": false
  }
}
